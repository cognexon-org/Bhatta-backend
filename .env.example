# ─────────────────────────────────────────────────────────────
# Shared Bhatta backend / control plane
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
JWT_SECRET=replace-with-strong-platform-jwt-secret
JWT_EXPIRES_IN=30d
PLATFORM_ADMIN_KEY=replace-with-strong-control-plane-key
CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Master registry DB. This can live in the same MongoDB Community process,
# but the credential should only have access to bhatta_master.
MASTER_MONGO_URI=mongodb://bhatta_master_user:CHANGE_ME@127.0.0.1:27017/bhatta_master?authSource=bhatta_master&replicaSet=rs0

# Production default: every tenant points to its own URI env variable and
# MongoDB user, even when all DBs are hosted by the same mongod process.
MONGO_URI_BH001=mongodb://bh001_user:CHANGE_ME@127.0.0.1:27017/bhatta_BH001?authSource=bhatta_BH001&replicaSet=rs0
MONGO_URI_BH002=mongodb://bh002_user:CHANGE_ME@127.0.0.1:27017/bhatta_BH002?authSource=bhatta_BH002&replicaSet=rs0

# Optional development-only root URI for Tenant.database.mode=SHARED_ROOT.
# Do not use a cross-database admin credential for production application traffic.
TENANT_SHARED_MONGO_ROOT_URI=mongodb://dev_user:CHANGE_ME@127.0.0.1:27017/dev?authSource=admin&replicaSet=rs0

TENANT_DB_MAX_POOL_SIZE=10
MASTER_DB_MAX_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
ALLOW_NON_TRANSACTIONAL_FALLBACK=false

# Voice AI defaults. A tenant can reference dedicated env names instead.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
VOICE_AI_TIMEOUT_MS=15000

# Per-client AI keys (examples)
GROQ_API_KEY_BH001=
GEMINI_API_KEY_BH001=
GROQ_API_KEY_BH002=
GEMINI_API_KEY_BH002=

# Optional common fallback keys. Tenant-specific keys take precedence.
GROQ_API_KEY=
GEMINI_API_KEY=

# Existing integrations
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads

# Cron can be disabled on local/dev nodes.
DISABLE_CRON=false

# Bootstrap/admin variables are NOT required by the running API. Use only for provisioning scripts.
# MONGO_ADMIN_USERNAME=bhatta_root
# MONGO_ADMIN_PASSWORD=
# MONGO_ADMIN_HOST=127.0.0.1:27017
# MONGO_REPLICA_SET=rs0
